{
  "_comment": "개발 PC 전용 MCP 설정 템플릿. .mcp.json 으로 복사해 쓴다(ADR-0004 예정). 센서(Pi)에는 MCP 서버를 상주시키지 않는다. 스캔/쉘 실행 권한을 LLM에 위임하는 MCP(nmap, pentest 계열)는 금지.",
  "mcpServers": {
    "netmon-duckdb": {
      "command": "uvx",
      "args": ["mcp-server-motherduck", "--db-path", "data/parquet", "--read-only"]
    },
    "netmon-sqlite": {
      "command": "uvx",
      "args": ["mcp-sqlite", "data/netmon.db", "--read-only"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    }
  }
}

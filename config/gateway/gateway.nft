#!/usr/sbin/nft -f
# netmon gateway: LAN 클라이언트 -> Pi -> 공유기 (hairpin on eth0) 를 위한 포워딩/NAT
# 테이블을 통째로 교체하므로 여러 번 적용해도 안전함
table inet netmon_gateway
delete table inet netmon_gateway
table inet netmon_gateway {
    chain forward {
        type filter hook forward priority 0; policy accept;
        iifname "eth0" oifname "eth0" counter comment "LAN hairpin forward"
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "eth0" ip saddr 192.168.45.0/24 ip daddr != 192.168.45.0/24 counter masquerade comment "LAN -> internet via router"
    }
}
